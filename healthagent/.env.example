SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key
# Pooler connection string, port 5432 (session mode) — used by the LangGraph checkpointer.
SUPABASE_DB_URL=
WEBHOOK_SECRET=choose-a-long-random-string
REDIS_URL=redis://redis:6379/0
QUEUE_NAME=events:realtime
ACTIVITY_QUEUE_NAME=activity:realtime
LLM_PROVIDER=openai
OPENAI_API_KEY=
LLM_MODEL=gpt-5.4-mini

# Mid-event check-ins. All optional — these are the defaults.
# Interval is clamped to a 60s floor; the three rule thresholds are range-checked
# and fall back loudly if set outside their bounds.
CHECK_IN_INTERVAL_SECONDS=600
CHECK_IN_MIN_ELAPSED_SECONDS=900
CHECK_IN_MAX_SECONDS=28800
DELAYED_QUEUE_NAME=events:delayed
# Lab extraction runs in its own lane: reading a photographed panel is slow and
# must not sit in front of a user waiting on a score.
LAB_QUEUE_NAME=labs:batch
# Blank until an engine has been measured against real reports from the labs
# your users actually use. Blank means a photograph or scan fails with a reason
# rather than being read by an unmeasured engine.
OCR_ENGINE=
CHECK_IN_HR_DELTA=12.0
CHECK_IN_HR_Z=2.0
CHECK_IN_HRV_DROP_PCT=25.0
